#
# QEMU_PC98 -- Pentium-or-newer UP kernel for PC-98 and qemu-pc98
#

cpu		I586_CPU
cpu		I686_CPU
ident		QEMU_PC98
hints		"QEMU_PC98.hints"

# P0 is a monolithic bring-up kernel.  Architecture-independent modules are
# intentionally deferred until the kernel entry and machine buses are proven.
makeoptions	MODULES_OVERRIDE=""

options		SCHED_4BSD
options		FFS
options		CD9660
options		TMPFS
options		PSEUDOFS
options		GEOM_LABEL
options		GEOM_PART_BSD
options		GEOM_PART_PC98
options		MD_ROOT
options		INET
options		KDB
options		KDB_TRACE
options		INCLUDE_CONFIG_FILE

device		loop
device		ether
device		pci
device		miibus
device		fxp
device		bpf

# PC-98 bank-0 ATA controller and CAM disk support.
device		ata
device		scbus
device		da
device		cd
device		pass

# Installer runtime support.
device		md

# Native PC-98 text console and keyboard.
device		pckbd
device		gdc
device		sc
